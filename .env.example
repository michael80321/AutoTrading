# Redis (Railway 自動注入,本機開發手動填)
REDIS_URL=redis://localhost:6379

# PostgreSQL (Railway 自動注入)
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_trading

# Binance Testnet (申請: testnet.binance.vision)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# IBKR Paper Trading (需本機 TWS 運行)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Feed mode: true=MockFeed(雲端預設), false=真實券商
USE_MOCK_FEED=true

# Tick 間隔(秒) 預設 60
TICK_INTERVAL_SECONDS=60
